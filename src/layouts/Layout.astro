---
const { title, description } = Astro.props;
const { 
  siteConfig, 
  contact,
} = (await import('../content.ts')).content;
import { randomBytes } from 'crypto';

const fullTitle = title ? `${title}` : siteConfig.title;

// Generate a CSP nonce for inline script security
const scriptNonce = randomBytes(16).toString('base64');

// Build JSON-LD schema as string for proper escaping
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": siteConfig.author,
  "jobTitle": siteConfig.title,
  "url": siteConfig.url,
  "sameAs": [
    contact.linkedIn,
    contact.github,
    contact.keybase,
  ],
  "description": siteConfig.description,
  "knowsAbout": [
    "Mobile & Device Security",
    "Wireless/RF Analysis",
    "Network Forensics",
    "Penetration Testing",
    "Security Architecture",
    "Incident Response"
  ]
};

const jsonLdString = JSON.stringify(jsonLd, null, 2);
---

<!DOCTYPE html>
<html lang="en-GB" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- Security headers -->
    <meta http-equiv="Content-Security-Policy" content={`script-src 'self' 'nonce-${scriptNonce}'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; object-src 'none'`} />
    
    <!-- Title -->
    <title>{fullTitle}</title>
    <meta name="description" content={description || siteConfig.description} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description || siteConfig.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteConfig.url} />
    <meta property="og:image" content={`${siteConfig.url}/images/og-image.svg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Michael Moran — Cyber Security Professional" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description || siteConfig.description} />
    <meta name="twitter:image" content={`${siteConfig.url}/images/og-image.svg`} />
    
    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.svg" />
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" />
    
    <!-- JSON-LD Person Schema -->
    <script type="application/ld+json" set:html={jsonLdString} />
    
    <!-- Styles -->
    <link rel="stylesheet" href="/styles/global.css" />
    
    <!-- Preload fonts for performance -->
    <link rel="preload" href="/fonts/Fraunces[wght].woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Inter[weight].woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/JetBrainsMono.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div id="page-content">
      <slot />
    </div>
    
    <!-- Scroll reveal script with CSP nonce -->
    <script is:inline nonce={scriptNonce}>
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
          }
        });
      }, { threshold: 0.1 });

      document.querySelectorAll('.reveal').forEach(el => {
        observer.observe(el);
      });
    </script>
  </body>
</html>