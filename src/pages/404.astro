---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

import content from '../content';
const { siteConfig, footer } = content;
---

<Layout title="404 — Page Not Found" description={siteConfig.description}>
  <section class="404-section">
    <div class="container">
      <div class="404-content">
        <h1 class="404-title">404</h1>
        <p class="404-tagline">Something went wrong.</p>
        <p class="404-message">
          The page you are looking for does not exist or has been moved.
        </p>
        <a href="/" class="404-home-link button-primary">
          Return to Home
        </a>
      </div>
    </div>
  </section>

  <Footer 
    copyright={footer.copyright}
    privacy={footer.privacyNote}
    securityMark="Security by design"
  />
</Layout>

<style>
  .404-section {
    padding: var(--space-6) var(--space-2);
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 48em) {
    .404-section {
      padding: var(--space-4) var(--space-1);
      min-height: auto;
    }
  }

  @media (max-width: 30em) {
    .404-section {
      padding: var(--space-3) var(--space-1);
    }
  }

  .404-content {
    text-align: center;
    width: 100%;
  }

  .404-title {
    font-family: 'Fraunces', serif;
    font-size: clamp(2rem, 8vw, 4rem);
    font-weight: 800;
    line-height: 1;
    margin: 0 0 var(--space-3) 0;
    color: var(--color-accent);
    opacity: 0.3;
  }

  .404-tagline {
    font-family: 'Fraunces', serif;
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    font-weight: 600;
    margin: 0 0 var(--space-3) 0;
  }

  .404-message {
    font-size: clamp(0.9rem, 2.2vw, 1.1rem);
    color: var(--color-meta);
    margin: var(--space-3) 0;
  }

  .404-home-link {
    text-decoration: none;
  }

  @media (max-width: 48em) {
    .404-title {
      font-size: clamp(2rem, 7vw, 3.5rem);
    }
  }

  @media (max-width: 30em) {
    .404-tagline {
      font-size: 1.1rem;
    }
    
    .404-message {
      font-size: 0.9rem;
      margin: var(--space-2) 0;
    }
  }
</style>