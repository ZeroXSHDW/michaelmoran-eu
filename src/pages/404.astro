---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

import {
  siteConfig,
  footer,
} from '../content';
---

<Layout title="404 — Page Not Found" description={siteConfig.description}>
  <section class="404-section">
    <div class="container">
      <div class="404-content">
        <h1 class="404-title">404</h1>
        <p class="404-tagline">Something went wrong.</p>
        <p class="404-message">
          The page you are looking for does not exist or has been moved.
        </p>
        <a href="/" class="404-home-link button-primary">
          Return to Home
        </a>
      </div>
    </div>
  </section>

  <Footer 
    copyright={footer.copyright}
    privacy={footer.privacy}
    securityMark={footer.securityMark}
  />
</Layout>

<style>
.404-section {
  padding: var(--space-6) var(--space-2);
  min-height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.404-content {
  text-align: center;
  max-width: 480px;
}

.404-title {
  font-family: 'Fraunces', serif;
  font-size: 4rem;
  font-weight: 800;
  line-height: 1;
  margin: 0 0 var(--space-3) 0;
  color: var(--color-accent);
  opacity: 0.3;
}

.404-tagline {
  font-family: 'Fraunces', serif;
  font-size: 1.5rem;
  font-weight: 600;
  margin: 0 0 var(--space-3) 0;
}

.404-message {
  font-size: 1.1rem;
  color: var(--color-meta);
  margin: var(--space-3) 0;
}

.404-home-link {
  text-decoration: none;
}

@media (min-width: 48em) {
  .404-title {
    font-size: 5rem;
  }
}
</style>