---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

import {
  siteConfig,
  hero,
  profile,
  capabilities,
  engagements,
  footer,
} from '../content';
---

<Layout title={"CV — " + hero.name} description={siteConfig.description}>
  <!-- CV Section -->
  <section id="cv" class="cv-section">
    <div class="container">
      <header class="cv-header">
        <h1 class="cv-name">{hero.name}</h1>
        <p class="cv-title accent">{hero.title}</p>
        <p class="cv-location">Dublin, Ireland • EU Citizen</p>
      </header>

      <div class="cv-content">
        <p class="cv-download">
          <a href="/cv/michael-moran-cv.pdf" download class="download-link">
            Download PDF Version
          </a>
        </p>

        <!-- Professional Summary -->
        <section class="cv-section-block">
          <h2 class="cv-section-title">Professional Summary</h2>
          <p>{profile.paragraphs[0]}</p>
        </section>

        <!-- Core Competencies -->
        <section class="cv-section-block">
          <h2 class="cv-section-title">Core Competencies</h2>
          <ul class="cv-competencies">
            {capabilities.items.map((item) => (
              <li class="cv-competency">{item.title}</li>
            ))}
          </ul>
        </section>

        <!-- Professional Experience -->
        <section class="cv-section-block">
          <h2 class="cv-section-title">Professional Experience</h2>
          <div class="cv-experience">
            {engagements.items.map((item) => (
              <div class="cv-experience-item">
                <div class="cv-experience-header">
                  <span class="cv-experience-year">{item.year}</span>
                  <h3 class="cv-experience-role">{item.role}</h3>
                </div>
                <p class="cv-experience-sector">{item.sector}</p>
                <p class="cv-experience-outcome">{item.outcome}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- Education & Certifications -->
        <section class="cv-section-block">
          <h2 class="cv-section-title">Certifications</h2>
          <p class="cv-note">Actual certification details to be added by owner.</p>
        </section>

        <!-- Contact -->
        <section class="cv-section-block">
          <h2 class="cv-section-title">Contact</h2>
          <p>
            <strong>Email:</strong>{' '}
            <a href={`mailto:contact@${siteConfig.url.replace('https://', '')}`}>
              contact@{siteConfig.url.replace('https://', '')}
            </a>
          </p>
          <p class="cv-small">
            <em>PDF available for print or archival purposes.</em>
          </p>
        </section>
      </div>
    </div>
  </section>

  <Footer 
    copyright={footer.copyright}
    privacy={footer.privacy}
    securityMark={footer.securityMark}
  />
</Layout>

<style>
.cv-section {
  padding: var(--space-6) var(--space-2);
}

.cv-header {
  text-align: center;
  margin-bottom: var(--space-5);
}

.cv-name {
  font-family: 'Fraunces', serif;
  font-size: 2.5rem;
  font-weight: 800;
  line-height: 1.1;
  margin: 0 0 var(--space-2) 0;
  color: var(--color-text);
}

.cv-title {
  font-size: 1.25rem;
  font-weight: 500;
  opacity: 0.8;
  margin-bottom: var(--space-2);
}

.cv-location {
  font-size: 1rem;
  color: var(--color-meta);
}

.cv-download {
  text-align: center;
  margin-bottom: var(--space-4);
}

.download-link {
  display: inline-block;
  padding: var(--space-2) var(--space-4);
  background-color: var(--color-accent);
  color: var(--color-white);
  text-decoration: none;
  border-radius: 4px;
  font-family: var(--font-mono, 'JetBrains Mono', monospace);
  font-weight: 600;
  transition: opacity var(--duration-fast) ease;
}

.download-link:hover,
.download-link:focus {
  opacity: 0.9;
}

.cv-section-block {
  margin-bottom: var(--space-5);
}

.cv-section-title {
  font-family: 'Fraunces', serif;
  font-size: 1.5rem;
  font-weight: 700;
  margin: 0 0 var(--space-3) 0;
  color: var(--color-text);
}

.cv-competencies {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: var(--space-2);
}

.cv-competency {
  background-color: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: 4px;
  padding: var(--space-2);
  font-family: var(--font-mono, 'JetBrains Mono', monospace);
  font-size: 0.9rem;
  color: var(--color-meta);
}

.cv-experience {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.cv-experience-item {
  background-color: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: 8px;
  padding: var(--space-3);
}

.cv-experience-header {
  display: flex;
  align-items: baseline;
  gap: var(--space-3);
  margin-bottom: var(--space-1);
}

.cv-experience-year {
  font-family: var(--font-mono, 'JetBrains Mono', monospace);
  font-size: 0.85rem;
  background-color: var(--color-accent);
  color: var(--color-white);
  padding: 0.25rem var(--space-2);
  border-radius: 4px;
}

.cv-experience-role {
  font-size: 1.1rem;
  font-weight: 600;
  margin: 0;
}

.cv-experience-sector {
  font-size: 0.95rem;
  color: var(--color-meta);
  margin: var(--space-1) 0;
}

.cv-experience-outcome {
  margin: 0;
  line-height: 1.4;
}

.cv-note {
  color: var(--color-meta);
  font-style: italic;
}

.cv-small {
  font-size: 0.85rem;
  color: var(--color-meta);
}

@media (min-width: 48em) {
  .cv-name {
    font-size: 3rem;
  }
  
  .cv-section-title {
    font-size: 1.75rem;
  }
}
</style>