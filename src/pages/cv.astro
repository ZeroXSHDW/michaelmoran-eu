---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

import {
  siteConfig,
  hero,
  footer,
} from '../content';
---

<Layout title="CV — " + hero.name description={siteConfig.description}>
  <!-- CV Section -->
  <section id="cv" class="cv-section">
    <div class="container">
      <header class="cv-header">
        <h1 class="cv-name">{hero.name}</h1>
        <p class="cv-title accent">{hero.title}</p>
      </header>

      <div class="cv-content">
        <p class="cv-download">
          <a href="/cv/michael-moran-cv.pdf" download class="download-link">
            Download PDF Version
          </a>
        </p>

        <article class="cv-document">
          <p class="cv-placeholder">
            <!-- TODO(owner): Replace with actual CV content or PDF embed -->
            This page hosts the CV for <strong>{hero.name}</strong>, 
            Cyber Security Professional. The PDF version is available above.
          </p>

          <div class="cv-preview-placeholder">
            <p>CV will be rendered as a PDF file. 
            For best compatibility, use the download link.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <Footer 
    copyright={footer.copyright}
    privacy={footer.privacy}
    securityMark={footer.securityMark}
  />
</Layout>

<style>
.cv-section {
  padding: var(--space-6) var(--space-2);
}

.cv-header {
  text-align: center;
  margin-bottom: var(--space-5);
}

.cv-name {
  font-family: 'Fraunces', serif;
  font-size: 2.5rem;
  font-weight: 800;
  line-height: 1.1;
  margin: 0 0 var(--space-2) 0;
  color: var(--color-text);
}

.cv-title {
  font-size: 1.25rem;
  font-weight: 500;
  opacity: 0.8;
}

.cv-download {
  text-align: center;
  margin-bottom: var(--space-4);
}

.download-link {
  display: inline-block;
  padding: var(--space-2) var(--space-4);
  background-color: var(--color-accent);
  color: var(--color-white);
  text-decoration: none;
  border-radius: 4px;
  font-family: var(--font-mono, 'JetBrains Mono', monospace);
  font-weight: 600;
  transition: opacity var(--duration-fast) ease;
}

.download-link:hover,
.download-link:focus {
  opacity: 0.9;
}

.cv-document {
  background-color: var(--color-white);
  border: 1px solid var(--color-border);
  border-radius: 8px;
  padding: var(--space-4);
}

.cv-placeholder {
  text-align: center;
  color: var(--color-meta);
}

.cv-preview-placeholder {
  margin-top: var(--space-4);
  padding: var(--space-3);
  text-align: center;
  color: var(--color-meta);
  border: 1px dashed var(--color-border);
  border-radius: 4px;
}
</style>