---
const { name, issuer, verificationUrl } = Astro.props;
---

<li class="credential-item">
  <div class="credential-primary">
    <span class="credential-name">{name}</span>
    <span class="credential-issuer">{issuer}</span>
  </div>
  {verificationUrl ? (
    <a href={verificationUrl} class="credential-verify" target="_blank" rel="noopener">
      Verify
    </a>
  ) : (
    <span class="credential-verify disabled">Verify</span>
  )}
</li>

<style>
  .credential-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-border);
    list-style: none;
    transition: border-color var(--duration-fast) ease;
  }

  @media (max-width: 48em) {
    .credential-item {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-1);
      padding: var(--space-2) 0;
    }
  }

  .credential-item:last-child {
    border-bottom: none;
  }

  .credential-primary {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .credential-name {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-text);
  }

  @media (max-width: 48em) {
    .credential-name {
      font-size: 0.85rem;
    }
  }

  .credential-issuer {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.8rem;
    color: var(--color-meta);
  }

  @media (max-width: 48em) {
    .credential-issuer {
      font-size: 0.75rem;
    }
  }

  .credential-verify {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    transition: background-color var(--duration-fast) ease, color var(--duration-fast) ease;
  }

  .credential-verify:hover,
  .credential-verify:focus {
    background-color: var(--color-bg);
    text-decoration: underline;
  }

  .credential-verify.disabled {
    color: var(--color-meta);
    cursor: not-allowed;
    pointer-events: none;
    background-color: transparent;
  }

  @media (max-width: 48em) {
    .credential-verify {
      align-self: flex-end;
    }
  }
</style>