---
interface Props {
  title: string;
  client?: string;
  sector?: string;
  period: string;
  challenge: string;
  approach: string;
  outcome: string;
  metrics?: string[];
  tags?: string[];
  confidentiality: 'public' | 'anonymized' | 'confidential';
  link?: string;
  featured?: boolean;
}
const { title, client, sector, period, challenge, approach, outcome, metrics, tags, confidentiality, link, featured: _featured } = Astro.props;
---

<article class="case-study-card reveal {featured ? 'featured' : ''}">
  <header class="case-study-header">
    <h3 class="case-study-title">{title}</h3>
    <div class="case-study-meta">
      {client && <span class="case-study-client">{client}</span>}
      {sector && <span class="case-study-sector">{sector}</span>}
      <span class="case-study-period">{period}</span>
      <span class="confidentiality-badge {confidentiality}">{confidentiality}</span>
    </div>
  </header>
  
  <div class="case-study-body">
    <section class="case-study-section">
      <h4>Challenge</h4>
      <p>{challenge}</p>
    </section>
    <section class="case-study-section">
      <h4>Approach</h4>
      <p>{approach}</p>
    </section>
    <section class="case-study-section">
      <h4>Outcome</h4>
      <p>{outcome}</p>
    </section>
  </div>
  
  {metrics && metrics.length > 0 && (
    <div class="case-study-metrics">
      <h4>Key Metrics</h4>
      <ul>
        {/* eslint-disable @typescript-eslint/no-unsafe-return */}
        {metrics.map(m => <li>{m}</li>)}
        {/* eslint-enable @typescript-eslint/no-unsafe-return */}
      </ul>
    </div>
  )}
  
  {tags && tags.length > 0 && (
    <div class="case-study-tags">
      {/* eslint-disable @typescript-eslint/no-unsafe-return */}
      {tags.map(tag => <span class="tag">{tag}</span>)}
      {/* eslint-enable @typescript-eslint/no-unsafe-return */}
    </div>
  )}
  
  {link && (
    <a href={link} class="case-study-link" target="_blank" rel="noopener noreferrer">
      View Details →
    </a>
  )}
</article>

<style>
  .case-study-card {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: var(--space-6);
    background-color: var(--color-card);
    transition: transform var(--duration-fast) ease, box-shadow var(--duration-fast) ease;
  }

  @media (max-width: 48em) {
    .case-study-card {
      padding: var(--space-3);
    }
  }

  .case-study-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }

  .case-study-card.featured {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  .case-study-header {
    margin-bottom: var(--space-4);
  }

  .case-study-title {
    font-family: 'Fraunces', serif;
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 var(--space-2) 0;
    color: var(--color-text);
  }

  @media (max-width: 48em) {
    .case-study-title {
      font-size: 1.125rem;
    }
  }

  .case-study-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.75rem;
    color: var(--color-meta);
  }

  @media (max-width: 48em) {
    .case-study-meta {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .case-study-client::before {
    content: "Client: ";
  }

  .case-study-sector::before {
    content: "Sector: ";
  }

  .case-study-period {
    color: var(--color-meta);
  }

  .confidentiality-badge {
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .confidentiality-badge.public {
    background-color: rgba(34, 197, 94, 0.15);
    color: #22c55e;
  }

  .confidentiality-badge.anonymized {
    background-color: rgba(234, 179, 8, 0.15);
    color: #eab308;
  }

  .confidentiality-badge.confidential {
    background-color: rgba(239, 68, 68, 0.15);
    color: #ea580c;
  }

  .case-study-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .case-study-section h4 {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    margin: 0 0 var(--space-2) 0;
  }

  .case-study-section p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text);
    margin: 0;
  }

  .case-study-metrics h4 {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    margin: 0 0 var(--space-2) 0;
  }

  .case-study-metrics ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .case-study-metrics li {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.8125rem;
    color: var(--color-meta);
    background-color: var(--color-bg);
    padding: var(--space-1) var(--space-3);
    border-radius: 4px;
  }

  .case-study-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.6875rem;
    padding: 2px 8px;
    border-radius: 4px;
    background-color: var(--color-bg);
    color: var(--color-meta);
    border: 1px solid var(--color-border);
  }

  .case-study-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .case-study-link:hover {
    color: var(--color-accent-hover);
  }
</style>